generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  STOCK_RESERVED
  PAID
  CONFIRMED
  COMPENSATING
  CANCELLED
}

enum ReservationStatus {
  RESERVED
  COMMITTED
  RELEASED
}

enum PaymentStatus {
  CHARGED
  DECLINED
  REFUNDED
}

// ---- products ----

/// stock has a CHECK (stock >= 0) constraint, added in the migration.
model Product {
  id           String             @id @default(uuid()) @db.Uuid
  sku          String             @unique
  name         String
  priceCents   Int                @map("price_cents")
  stock        Int
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  orderItems   OrderItem[]
  reservations StockReservation[]

  @@map("products")
}

// ---- orders ----

model Order {
  id            String      @id @default(uuid()) @db.Uuid
  customerEmail String      @map("customer_email")
  status        OrderStatus @default(PENDING)
  totalCents    Int         @map("total_cents")
  /// Token from the payment provider's client SDK (never a card number).
  paymentToken  String      @map("payment_token")
  failureReason String?     @map("failure_reason")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  items         OrderItem[]

  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(uuid()) @db.Uuid
  orderId        String  @map("order_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  quantity       Int
  unitPriceCents Int     @map("unit_price_cents")
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

// ---- inventory ----

model StockReservation {
  id        String            @id @default(uuid()) @db.Uuid
  orderId   String            @map("order_id") @db.Uuid
  productId String            @map("product_id") @db.Uuid
  quantity  Int
  status    ReservationStatus
  expiresAt DateTime          @map("expires_at")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  product   Product           @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])
  @@map("stock_reservations")
}

// ---- payments ----

model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  orderId          String        @unique @map("order_id") @db.Uuid
  amountCents      Int           @map("amount_cents")
  status           PaymentStatus
  providerChargeId String?       @map("provider_charge_id")
  declineReason    String?       @map("decline_reason")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@map("payments")
}

// ---- events ----

/// Transactional outbox: written in the same transaction as the state change it describes.
/// eventId is not unique: a redriven dead letter is re-published with its original event id.
model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  eventId     String    @map("event_id") @db.Uuid
  type        String
  aggregateId String    @map("aggregate_id") @db.Uuid
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}

/// Inbox: one row per event a consumer has fully handled. The unique key makes handling idempotent.
model InboxEntry {
  id          String   @id @default(uuid()) @db.Uuid
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  eventType   String   @map("event_type")
  processedAt DateTime @default(now()) @map("processed_at")

  @@unique([consumer, eventId])
  @@map("inbox_entries")
}

/// A message a consumer failed to handle MAX_DELIVERY_ATTEMPTS times.
model DeadLetter {
  id          String    @id @default(uuid()) @db.Uuid
  consumer    String
  eventId     String    @map("event_id") @db.Uuid
  eventType   String    @map("event_type")
  aggregateId String    @map("aggregate_id") @db.Uuid
  payload     Json
  error       String
  attempts    Int
  createdAt   DateTime  @default(now()) @map("created_at")
  redrivenAt  DateTime? @map("redriven_at")

  @@index([createdAt])
  @@map("dead_letters")
}
