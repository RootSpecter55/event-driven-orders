# --- Runtime ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Secrets loading (scripts/start-with-secrets.ts) ---
# local: use this .env file. aws: fetch one JSON secret from AWS Secrets Manager.
SECRETS_SOURCE=local
SECRET_ID=
AWS_REGION=

# --- Database and Redis ---
DATABASE_URL=postgresql://app:app@localhost:5446/orders
REDIS_URL=redis://localhost:6382/0

# --- Admin API key (products, payments, reservations, events endpoints) ---
ADMIN_API_KEY=change-me-admin-api-key

# --- Message bus (MessageBus) ---
# redis: Redis Streams with consumer groups. sns-sqs: AWS SNS topic + one SQS queue per consumer.
MESSAGE_BUS=redis
EVENTS_STREAM=events
SNS_TOPIC_ARN=
SQS_QUEUE_URL_INVENTORY=
SQS_QUEUE_URL_PAYMENTS=
SQS_QUEUE_URL_ORDERS=

# --- Outbox relay and consumers ---
RELAY_INTERVAL_MS=500
RELAY_BATCH_SIZE=100
MAX_DELIVERY_ATTEMPTS=5
RETRY_DELAY_MS=5000

# --- Checkout ---
# How long reserved stock is held while the payment runs. A commit after this fails and is refunded.
RESERVATION_TTL_SECONDS=300
# Fake payment provider: decline every charge (the token "tok_declined" is always declined).
FAKE_PAYMENT_DECLINE=false
